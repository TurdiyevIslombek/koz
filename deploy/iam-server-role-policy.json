{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ItsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:*:table/koz-web"
      ]
    },
    {
      "Sid": "ItsPassword",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-2:*:secret:koz-owner-password-??????"
      ]
    }
  ]
}
