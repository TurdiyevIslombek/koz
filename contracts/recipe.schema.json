{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ko'z recipe, version 1",
  "$comment": "Structural check only. contracts/events.md section 3 lists the extra checks the runner must also make. A recipe never holds device setup (camera address, ownership, allowed area, motor arming).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "camera", "blocks", "brain", "actions", "privacy"],
  "properties": {
    "version": { "const": 1 },
    "language": { "enum": ["uz", "ru", "en"] },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "size", "fps"],
      "properties": {
        "source": { "const": "device_camera" },
        "size": { "enum": ["320x240", "640x480"] },
        "fps": { "type": "integer", "minimum": 1, "maximum": 15 }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/privacy_guard" },
        { "$ref": "#/$defs/face_blur" }
      ],
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/color_finder" },
          { "$ref": "#/$defs/object_finder" },
          { "$ref": "#/$defs/motion_zone" },
          { "$ref": "#/$defs/person_detector" },
          { "$ref": "#/$defs/line_counter" },
          { "$ref": "#/$defs/looming" }
        ]
      }
    },
    "brain": {
      "oneOf": [
        { "$ref": "#/$defs/brain_none" },
        { "$ref": "#/$defs/brain_flybrain" }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "dashboard" } }
        }
      ],
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/alert" },
          { "$ref": "#/$defs/motors" }
        ]
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school"],
      "properties": {
        "school": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Rule 6: school mode allows counting only.",
      "if": {
        "required": ["privacy"],
        "properties": { "privacy": { "required": ["school"], "properties": { "school": { "const": true } } } }
      },
      "then": {
        "properties": {
          "brain": { "$ref": "#/$defs/brain_none" },
          "blocks": {
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/privacy_guard" },
                { "$ref": "#/$defs/face_blur" },
                { "$ref": "#/$defs/person_detector" },
                { "$ref": "#/$defs/line_counter" }
              ]
            }
          },
          "actions": { "const": [{ "type": "dashboard" }] }
        }
      }
    },
    {
      "$comment": "Rule 11: motors only with the fly brain, and the fly brain only reads color_finder.",
      "if": {
        "required": ["brain"],
        "properties": { "brain": { "required": ["type"], "properties": { "type": { "const": "flybrain" } } } }
      },
      "then": {
        "properties": {
          "blocks": { "contains": { "$ref": "#/$defs/is_color_finder" } },
          "actions": { "contains": { "$ref": "#/$defs/is_motors" } }
        }
      },
      "else": {
        "properties": {
          "actions": { "not": { "contains": { "$ref": "#/$defs/is_motors" } } }
        }
      }
    },
    {
      "$comment": "One finder per recipe (Codex review, Oct 22): a thing must never stand in for the car's ball in a check.",
      "not": {
        "required": ["blocks"],
        "properties": { "blocks": { "allOf": [{ "contains": { "$ref": "#/$defs/is_color_finder" } },
                                             { "contains": { "$ref": "#/$defs/is_object_finder" } }] } }
      }
    },
    {
      "$comment": "line_counter counts person_detector results.",
      "if": {
        "required": ["blocks"],
        "properties": { "blocks": { "contains": { "$ref": "#/$defs/is_line_counter" } } }
      },
      "then": {
        "properties": { "blocks": { "contains": { "$ref": "#/$defs/is_person_detector" } } }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "rect": {
      "$comment": "[left, top, right, bottom], normalized 0..1; left < right and top < bottom are checked by the runner.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "no_settings": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "privacy_guard": {
      "$comment": "Locked: fixed code policy, nothing to tune.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "privacy_guard" },
        "settings": { "$ref": "#/$defs/no_settings" }
      }
    },
    "face_blur": {
      "$comment": "Locked: fixed code policy, nothing to tune.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "face_blur" },
        "settings": { "$ref": "#/$defs/no_settings" }
      }
    },
    "color_finder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "color_finder" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hue_center", "hue_half_width", "saturation_min", "value_min", "min_area_ratio"],
          "properties": {
            "hue_center": { "type": "integer", "minimum": 0, "maximum": 179 },
            "hue_half_width": { "type": "integer", "minimum": 1, "maximum": 30 },
            "saturation_min": { "type": "integer", "minimum": 50, "maximum": 255 },
            "value_min": { "type": "integer", "minimum": 30, "maximum": 255 },
            "min_area_ratio": { "type": "number", "minimum": 0.001, "maximum": 0.25 }
          }
        }
      }
    },
    "object_finder": {
      "$comment": "Oct 22: one kind of everyday thing (COCO, NanoDet on OpenCV 5), optionally of one colour; reported like color_finder. Never people or animals (rules 4, 11); never the car's input.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "object_finder" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object", "colour", "min_confidence"],
          "properties": {
            "object": { "enum": ["cell phone", "backpack", "handbag", "suitcase", "umbrella", "bottle", "cup", "bowl",
                                 "laptop", "keyboard", "mouse", "remote", "book", "clock", "chair", "scissors",
                                 "teddy bear", "apple", "banana", "tv", "vase", "potted plant", "bicycle"] },
            "colour": { "enum": ["any", "red", "orange", "yellow", "green", "blue", "purple", "white", "black", "grey"] },
            "min_confidence": { "type": "number", "minimum": 0.3, "maximum": 0.95 }
          }
        }
      }
    },
    "motion_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "motion_zone" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rect", "pixel_delta", "min_changed_ratio"],
          "properties": {
            "rect": { "$ref": "#/$defs/rect" },
            "pixel_delta": { "type": "integer", "minimum": 10, "maximum": 80 },
            "min_changed_ratio": { "type": "number", "minimum": 0.01, "maximum": 0.5 }
          }
        }
      }
    },
    "person_detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "person_detector" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_confidence"],
          "properties": {
            "min_confidence": { "type": "number", "minimum": 0.3, "maximum": 0.95 }
          }
        }
      }
    },
    "line_counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "line_counter" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line"],
          "properties": {
            "line": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "looming": {
      "$comment": "Stretch block. The runner rejects it unless status.capabilities lists looming.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "looming" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_expansion_per_second"],
          "properties": {
            "min_expansion_per_second": { "type": "number", "minimum": 0.1, "maximum": 5 }
          }
        }
      }
    },
    "brain_none": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "none" } }
    },
    "brain_flybrain": {
      "$comment": "Steering reads only color_finder (and looming when present), never person results.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "settings"],
      "properties": {
        "type": { "const": "flybrain" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turn_gain", "deadband"],
          "properties": {
            "turn_gain": { "type": "number", "minimum": 0.1, "maximum": 2 },
            "deadband": { "type": "number", "minimum": 0.02, "maximum": 0.25 }
          }
        }
      }
    },
    "alert": {
      "$comment": "In-app badge with a fixed message. No email, SMS, police or discipline reports.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "template"],
      "properties": {
        "type": { "const": "alert" },
        "template": { "enum": ["motion_detected", "count_changed"] }
      }
    },
    "motors": {
      "$comment": "The runner uses the lower of this and the local tested speed cap. Cannot arm motors.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "max_speed_ratio"],
      "properties": {
        "type": { "const": "motors" },
        "max_speed_ratio": { "type": "number", "minimum": 0.05, "maximum": 0.25 }
      }
    },
    "is_color_finder": { "type": "object", "required": ["type"], "properties": { "type": { "const": "color_finder" } } },
    "is_object_finder": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object_finder" } } },
    "is_person_detector": { "type": "object", "required": ["type"], "properties": { "type": { "const": "person_detector" } } },
    "is_line_counter": { "type": "object", "required": ["type"], "properties": { "type": { "const": "line_counter" } } },
    "is_motors": { "type": "object", "required": ["type"], "properties": { "type": { "const": "motors" } } }
  }
}
